{
  "name": "betelquiz",
  "version": "1.0.0",
  "description": "Custom high-fidelity BetelQuiz platform",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "prestart": "npm run build",
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"blue.bold,magenta.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm --prefix client run build",
    "test:unit": "node --test --test-force-exit server/test/audit_fixes.test.js server/test/scoring.test.js server/test/features_v2.test.js server/test/puzzle_reveal.test.js server/test/phase1_cleanup.test.js server/test/game_logger.test.js server/test/sync_protocol.test.js",
    "test": "npm run test:unit"
  },
  "keywords": [
    "kahoot",
    "quiz",
    "realtime",
    "socketio"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^10.0.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "uuid": "^14.0.3"
  }
}
